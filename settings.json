{
  "permissions": {
    "allow": [
      "Bash(ls*)", "Bash(cat*)", "Bash(head*)", "Bash(tail*)", "Bash(wc*)",
      "Bash(df*)", "Bash(grep*)", "Bash(awk*)", "Bash(sort*)", "Bash(uniq*)",
      "Bash(squeue*)", "Bash(sinfo*)", "Bash(sacct*)", "Bash(scontrol show*)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)",
      "Bash(module*)", "Bash(conda env list*)", "Bash(conda run*)",
      "Bash(tmux ls*)", "Bash(tmux has-session*)", "Bash(tmux capture-pane*)", "Bash(tmux new-session -d*)"
    ],
    "ask": [
      "Bash(sbatch*)", "Bash(scancel*)", "Bash(rm*)", "Bash(mv*)",
      "Bash(chmod*)", "Bash(chown*)", "Bash(git push*)",
      "Bash(pip install*)", "Bash(conda install*)", "Bash(conda create*)",
      "Bash(curl*)", "Bash(wget*)"
    ],
    "deny": [
      "Bash(rm -r*)", "Bash(rm -R*)", "Bash(rm -fr*)", "Bash(rm -fR*)", "Bash(rm --recursive*)",
      "Bash(git clean*)", "Bash(git reset --hard*)", "Bash(git push --force*)", "Bash(git push -f*)",
      "Bash(shred*)", "Bash(truncate*)"
    ]
  },
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Recursive or forced deletes (rm -r/-rf, find -delete, rsync --delete, truncate, shred) and history-rewriting git (clean, reset --hard, push --force), even when wrapped in tmux, conda run, xargs, bash -c or a script: Mike runs these himself."
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/bash-guard.sh", "timeout": 10, "onFailure": "block", "statusMessage": "bash-guard" }
        ]
      }
    ]
  }
}
