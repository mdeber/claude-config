# Allowlist: ignore everything, then un-ignore the hand-written config.
*

!.gitignore
!README.md
!CLAUDE.md
!settings.json
!settings.local.json

!rules/
!rules/**
!agents/
!agents/**
!commands/
!commands/**
!skills/
!skills/**
!hooks/
!hooks/**
!notes/
!notes/**
!bin/
!bin/**

# Explicit secret/state exclusions. Keep these LAST: the final matching rule
# wins, so they hold even if an un-ignore line above is later made too broad.
.credentials.json
sessions/
backups/
skills/synced/
plugins/synced/
*.key
*~
\#*#
.DS_Store
# Per-user Claude memory: personal, not shared.
projects/
